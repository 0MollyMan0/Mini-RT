# =========================
# MINI RT - SPHERE STRESS TEST
# =========================
# Cette scène teste :
# - profondeur
# - chevauchement
# - ombres
# - variations de couleurs
# - lumière rasante
# - sphères proches / lointaines
# - alignements
# - perception de volume
# - contraste lumière / ambiance
# - intersections visuelles
# =========================

A 0.2 255,255,255

C 0,0,0 0,0,-1 70

L 25,25,10 0.9 200,150,150


# =========================
# GROSSE SPHERE CENTRALE
# =========================
sp 0,0,-40 14 220,220,220
sp -16,0,-50 14 220,220,220

# =========================
# SPHERES AUTOUR
# =========================

sp -22,0,-55 8 255,0,0
sp 22,0,-55 8 0,255,0

sp 0,20,-60 8 0,0,255
sp 0,-20,-60 8 255,255,0

sp -18,18,-70 7 255,0,255
sp 18,18,-70 7 0,255,255

sp -18,-18,-70 7 255,140,0
sp 18,-18,-70 7 180,0,255


# =========================
# PETITES SPHERES PROFONDES
# =========================

